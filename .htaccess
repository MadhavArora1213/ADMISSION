# =============================================
# AdmissionSeason - .htaccess
# Hostinger: document root = ADMISSION folder
# Localhost: access via /ADMISSION/
# =============================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Auto-detect: localhost pe /ADMISSION/, hosted pe /
    RewriteBase /ADMISSION/

    # ── Force HTTPS (skip localhost) ──
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── Redirect www to non-www ──
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # ── Existing files/dirs pass through ──
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── Favicon ──
    RewriteRule ^favicon\.ico$ favicon.svg [L,NC]

    # ── Sitemaps ──
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^sitemap-news\.xml$ sitemap-news.php [L,QSA]

    # ── Counselling ──
    RewriteRule ^counselling/?$ counselling.php [L,QSA]
    RewriteRule ^counseling/?$ counselling.php [L,QSA]

    # ── Study Abroad ──
    RewriteRule ^study-abroad/?$ study_abroad.php [L,QSA]
    RewriteRule ^foreign-university/([^\s]+)/?$ foreign-university.php?slug=$1 [L,QSA]
    RewriteRule ^visa-guide/([^\s]+)/?$ visa-guide.php?slug=$1 [L,QSA]

    # ── Consultants ──
    RewriteRule ^consultant/([0-9]+)/?$ consultant.php?id=$1 [L,QSA]
    RewriteRule ^experts/?$ experts.php [L,QSA]

    # ── Universities ──
    RewriteRule ^universities/?$ universities.php [L,QSA]
    RewriteRule ^university/([^\s]+?)/([^\s]+?)/?$ university.php?slug=$1&tab=$2 [L,QSA]
    RewriteRule ^university/([^\s]+?)/?$ university.php?slug=$1 [L,QSA]

    # ── Community ──
    RewriteRule ^community/?$ community.php [L,QSA]
    RewriteRule ^discussions/?$ community.php?tab=discussions [L,QSA]
    RewriteRule ^ask-question/?$ ask-question.php [L,QSA]

    # ── Colleges ──
    RewriteRule ^colleges/?$ colleges.php [L,QSA]
    RewriteRule ^college/([^\s]+?)/([^\s]+?)/?$ college.php?slug=$1&tab=$2 [L,QSA]
    RewriteRule ^college/([^\s]+?)/?$ college.php?slug=$1 [L,QSA]

    # ── Exams ──
    RewriteRule ^exams/?$ exams.php [L,QSA]
    RewriteRule ^exam/([^\s]+?)/([^\s]+?)/?$ exam.php?slug=$1&tab=$2 [L,QSA]
    RewriteRule ^exam/([^\s]+?)/?$ exam.php?slug=$1 [L,QSA]

    # ── Courses ──
    RewriteRule ^courses/?$ courses.php [L,QSA]
    RewriteRule ^course/([^\s]+?)/([^\s]+?)/?$ course.php?slug=$1&tab=$2 [L,QSA]
    RewriteRule ^course/([^\s]+?)/?$ course.php?slug=$1 [L,QSA]

    # ── Careers ──
    RewriteRule ^careers/?$ careers.php [L,QSA]
    RewriteRule ^career/?$ careers.php [L,QSA]
    RewriteRule ^career/([^\s]+?)/?$ career_details.php?slug=$1 [L,QSA]

    # ── News / Questions ──
    RewriteRule ^news/rss/?$ news/rss.php [L,QSA]
    RewriteRule ^news/([^\s]+)/?$ news_details.php?slug=$1 [L,QSA]
    RewriteRule ^question/([^\s]+)/?$ question_detail.php?id=$1 [L,QSA]

    # ── Cookie Policy ──
    RewriteRule ^cookie-policy/?$ cookie-policy.php [L,QSA]

    # ── Rankings / Predictor / Compare ──
    RewriteRule ^rankings/?$ rankings.php [L,QSA]
    RewriteRule ^predictor/?$ predictor.php [L,QSA]
    RewriteRule ^compare/?$ compare.php [L,QSA]
    RewriteRule ^saved/?$ saved_colleges.php [L,QSA]
    RewriteRule ^search/?$ search.php [L,QSA]
    RewriteRule ^profile/?$ profile.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^signup/?$ signup.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]
    RewriteRule ^news/?$ news.php [L,QSA]

    # ── Catch-all ──
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ index.php?url=$1 [L,QSA]
</IfModule>

# ── Security Headers ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block sensitive files ──
<FilesMatch "\.(sql|log|env|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Compression ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>

# ── Caching ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
