# =============================================
# AdmissionSeason - Admin .htaccess
# Hostinger Compatible (PHP-FPM safe)
# =============================================

Options -Indexes

# -------------------------------------------------
# Rewrite Engine
# -------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/admin/$1 [R=301,L]
</IfModule>

# -------------------------------------------------
# Security Headers
# -------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# -------------------------------------------------
# Block access to sensitive file types
# -------------------------------------------------
<FilesMatch "\.(sql|log|env|sh|bak|ps1)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>
