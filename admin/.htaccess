# Admin Directory Security

# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "\.(env|log|sql|bak|config|ini|sh|md)$">
    Require all denied
</FilesMatch>

# Block access to db.php directly
<Files "db.php">
    Require all denied
</Files>

<Files "security.php">
    Require all denied
</Files>

<Files "auth_check.php">
    Require all denied
</Files>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Rate limit login attempts (if mod_ratelimit is available)
<IfModule mod_ratelimit.c>
    <Location "/ADMISSION/admin/index.php">
        SetOutputFilter RATE_LIMIT
        SetEnv rate-limit 10
    </Location>
</IfModule>
